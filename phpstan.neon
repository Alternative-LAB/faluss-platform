parameters:
    level: 7
    paths:
        - src
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - phpstan/elementor-stubs.php
        - phpstan/portal-runtime-stubs.php
    excludePaths:
        analyse:
            - src/Portal/LegacyPortalService.php
            - src/Portal/LegacyPortalManifest.php
            - src/Portal/LegacyPortalAppsRegistryAdapter.php
            - src/Portal/LegacyPortalEventsCatalog.php
            - src/Portal/LegacyPortalEventsRuntime.php
            - src/Link/LegacyLinkAdmin.php
            - src/Link/LegacyLinkEventsCatalog.php
            - src/Link/LegacyLinkEventsRuntime.php
            - src/Link/LegacyLinkManifest.php
            - src/Link/LegacyLinkSchema.php
            - src/Link/LegacyLinkService.php
            - src/Link/LegacyLinkWidgets.php
            - src/Subscriptions/Legacy/includes/*.php
            - src/TokenEngine/Legacy/includes/*.php
    tmpDir: .cache/phpstan
