{
  "name": "alternative-lab/faluss-platform",
  "description": "Modular WordPress foundation for the Faluss ecosystem",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Faluss\\Platform\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Faluss\\Platform\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "test": "phpunit --colors=never"
  }
}
