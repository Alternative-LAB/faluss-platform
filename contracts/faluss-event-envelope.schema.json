{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.faluss.com/events/v1/faluss-event-envelope.schema.json",
  "title": "Faluss event envelope v1",
  "description": "EVT-01A documentary contract only. This schema defines an immutable server-produced business fact and creates no event runtime, transport, storage or WordPress behavior.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 14,
  "required": [
    "contract_version",
    "event_id",
    "event_type",
    "event_version",
    "source",
    "source_event_reference",
    "occurred_at",
    "produced_at",
    "subject_context",
    "actor_context",
    "object_context",
    "destinations",
    "payload_contract",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "$ref": "#/$defs/uuidV4"
    },
    "event_type": {
      "$ref": "#/$defs/namespacedKey"
    },
    "event_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "source_event_reference": {
      "$ref": "#/$defs/opaqueReference"
    },
    "occurred_at": {
      "$ref": "#/$defs/strictUtcDateTime"
    },
    "produced_at": {
      "$ref": "#/$defs/strictUtcDateTime"
    },
    "subject_context": {
      "$ref": "#/$defs/subjectContext"
    },
    "actor_context": {
      "$ref": "#/$defs/actorContext"
    },
    "object_context": {
      "$ref": "#/$defs/objectContext"
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/destination"
      }
    },
    "payload_contract": {
      "$ref": "#/$defs/payloadContract"
    },
    "payload": {
      "$ref": "#/$defs/payloadObject"
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "uuidV4": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "appKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "namespacedKey": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9-]{1,63}(?:\\.[a-z][a-z0-9-]{1,63}){1,7}$"
    },
    "documentType": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9-]{1,63}(?:\\.[a-z][a-z0-9-]{1,63}){1,7}$"
    },
    "opaqueReference": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "strictUtcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "app_key",
        "owner",
        "capability_key",
        "catalog_version"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nodeId"
        },
        "app_key": {
          "$ref": "#/$defs/appKey"
        },
        "owner": {
          "$ref": "#/$defs/appKey"
        },
        "capability_key": {
          "$ref": "#/$defs/namespacedKey"
        },
        "catalog_version": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "subjectContext": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject_type",
            "subject_faluss_id"
          ],
          "properties": {
            "subject_type": {
              "const": "faluss_member"
            },
            "subject_faluss_id": {
              "$ref": "#/$defs/uuidV4"
            }
          }
        }
      ]
    },
    "actorContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_faluss_id",
        "anonymous_reference",
        "anonymous_scope"
      ],
      "properties": {
        "actor_type": {
          "enum": [
            "member",
            "system",
            "anonymous"
          ]
        },
        "actor_faluss_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/uuidV4"
            }
          ]
        },
        "anonymous_reference": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/opaqueReference"
            }
          ]
        },
        "anonymous_scope": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "request",
                "daily"
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actor_type": {
                "const": "member"
              }
            },
            "required": [
              "actor_type"
            ]
          },
          "then": {
            "properties": {
              "actor_faluss_id": {
                "$ref": "#/$defs/uuidV4"
              },
              "anonymous_reference": {
                "type": "null"
              },
              "anonymous_scope": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "actor_type": {
                "const": "system"
              }
            },
            "required": [
              "actor_type"
            ]
          },
          "then": {
            "properties": {
              "actor_faluss_id": {
                "type": "null"
              },
              "anonymous_reference": {
                "type": "null"
              },
              "anonymous_scope": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "actor_type": {
                "const": "anonymous"
              }
            },
            "required": [
              "actor_type"
            ]
          },
          "then": {
            "properties": {
              "actor_faluss_id": {
                "type": "null"
              }
            },
            "oneOf": [
              {
                "properties": {
                  "anonymous_reference": {
                    "type": "null"
                  },
                  "anonymous_scope": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "anonymous_reference": {
                    "$ref": "#/$defs/opaqueReference"
                  },
                  "anonymous_scope": {
                    "enum": [
                      "request",
                      "daily"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "objectContext": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object_type",
            "object_reference"
          ],
          "properties": {
            "object_type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,63}$"
            },
            "object_reference": {
              "$ref": "#/$defs/opaqueReference"
            }
          }
        }
      ]
    },
    "destination": {
      "enum": [
        "analytics.events",
        "quests.events",
        "progression.events"
      ]
    },
    "payloadContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "contract_version"
      ],
      "properties": {
        "document_type": {
          "$ref": "#/$defs/documentType"
        },
        "contract_version": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "payloadPropertyName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "not": {
        "enum": [
          "metadata",
          "meta",
          "context",
          "properties",
          "faluss_id",
          "subject_faluss_id",
          "actor_faluss_id",
          "wp_user_id",
          "email",
          "login",
          "name",
          "display_name",
          "pseudonym",
          "handle",
          "url",
          "raw_url",
          "domain",
          "slug",
          "title",
          "label",
          "content",
          "ip",
          "user_agent",
          "cookie",
          "session",
          "otp",
          "authorization_code",
          "nonce",
          "signature",
          "public_key",
          "private_key",
          "stripe_id",
          "stripe_customer",
          "stripe_payment",
          "stripe_payload",
          "card_data",
          "card_number",
          "private_content",
          "bio",
          "link_content",
          "media_path",
          "media_file",
          "pf_balance",
          "idempotency_key",
          "economic_idempotency_key",
          "command",
          "authorization",
          "entitlement",
          "reward"
        ]
      }
    },
    "payloadScalar": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "maxLength": 256
        }
      ]
    },
    "payloadValueLevel4": {
      "$ref": "#/$defs/payloadScalar"
    },
    "payloadValueLevel3": {
      "oneOf": [
        {
          "$ref": "#/$defs/payloadScalar"
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/payloadValueLevel4"
          }
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/payloadPropertyName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/payloadValueLevel4"
          }
        }
      ]
    },
    "payloadValueLevel2": {
      "oneOf": [
        {
          "$ref": "#/$defs/payloadScalar"
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/payloadValueLevel3"
          }
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/payloadPropertyName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/payloadValueLevel3"
          }
        }
      ]
    },
    "payloadValueLevel1": {
      "oneOf": [
        {
          "$ref": "#/$defs/payloadScalar"
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/payloadValueLevel2"
          }
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/payloadPropertyName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/payloadValueLevel2"
          }
        }
      ]
    },
    "payloadObject": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/payloadPropertyName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/payloadValueLevel1"
      }
    }
  },
  "x-payload-validation": {
    "specialized_validator_required": true,
    "exact_contract_match_required": true,
    "on_missing_validator": "reject",
    "generic_schema_does_not_validate_owner_semantics": true,
    "limits": {
      "max_total_bytes": 8192,
      "max_total_fields": 128,
      "max_fields_per_object": 32,
      "max_depth": 4,
      "max_string_length": 256,
      "max_array_items": 32,
      "non_integer_numbers_require_specialized_contract": true
    }
  },
  "x-semantic-invariants": {
    "server_validation_required": true,
    "on_violation": "reject",
    "source_owner_equals_app_key": true,
    "event_type_prefix": "source.app_key + '.'",
    "capability_key_prefix": "source.app_key + '.'",
    "capability_interface_required": "event_source",
    "catalog_exact_match_required": true,
    "destinations_subset_of_catalog": true,
    "occurred_at_not_after_produced_at": true,
    "timestamps_server_owned": true,
    "browser_timestamp_and_wordpress_timezone_forbidden": true,
    "faluss_id_allowed_paths": [
      "subject_context.subject_faluss_id",
      "actor_context.actor_faluss_id"
    ],
    "anonymous_reference_server_owned": true,
    "anonymous_reference_cross_app_linkage_forbidden": true,
    "payload_and_references_sensitive_data_forbidden": true
  },
  "x-idempotency": {
    "event_id_unique": true,
    "business_identity_fields": [
      "source.node_id",
      "source.app_key",
      "event_type",
      "event_version",
      "source_event_reference"
    ],
    "retry_comparison": "RFC8785-JCS-SHA256",
    "encoding": "UTF-8",
    "array_order_significant": true,
    "same_identity_same_hash": "return_existing",
    "same_identity_different_hash": "reject_conflict",
    "same_source_reference_new_event_id": "reject_conflict",
    "same_source_reference_different_version": "reject_conflict",
    "accepted_event_mutation": "forbidden",
    "accepted_event_deletion_as_correction": "forbidden"
  },
  "x-delivery-semantics": {
    "producer_delivery": "at-least-once",
    "consumer_effect": "exactly-once-by-idempotence",
    "event_storage": "append-only",
    "one_event_for_multiple_destinations": true,
    "delivery_uniqueness_per_consumer": true,
    "consumer_failure_isolated": true
  },
  "x-forbidden-data": [
    "email",
    "login",
    "name_or_pseudonym",
    "handle",
    "raw_url_or_domain",
    "ip_address",
    "raw_user_agent",
    "cookie",
    "session",
    "otp",
    "authorization_code",
    "transport_nonce",
    "signature",
    "public_or_private_key",
    "stripe_identifier_or_payload",
    "payment_card_data",
    "private_content",
    "bio_text",
    "link_content",
    "media_path_or_file",
    "wp_user_id",
    "pf_balance",
    "economic_idempotency_key",
    "free_metadata",
    "executable_content"
  ],
  "x-evt01a-scope": {
    "nature": "documentary-contract-only",
    "wordpress_runtime_changes": false,
    "transport": false,
    "tables_or_migrations": false,
    "endpoints": false,
    "real_events": false,
    "assets_or_ui_changes": false,
    "allowed_changed_paths": [
      "docs/FALUSS_EVENTS_CONTRACT.md",
      "contracts/faluss-event-envelope.schema.json",
      "contracts/faluss-event-source-catalog.schema.json",
      "tests/faluss-events-evt01a-contract-test.php",
      "docs/FALUSS_CAPABILITIES_CONTRACT.md",
      "docs/FALUSS_FEDERATION_CONTRACT.md",
      "docs/FALUSS_PORTAL.md",
      "docs/ARCHITECTURE.md",
      "docs/DATA_MODEL.md",
      "docs/ROADMAP.md"
    ]
  }
}
